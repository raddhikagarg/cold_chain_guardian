# Copy this file to .env and fill in your own values.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/cold-chain-guardian
CLIENT_ORIGIN=http://localhost:5173

# Integration tests only. Use a throwaway database whose name contains "test".
# The suites refuse to run when MONGODB_URI_TEST equals MONGODB_URI.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/cold-chain-guardian-test
# ALLOW_DB_INTEGRATION_TESTS=true
